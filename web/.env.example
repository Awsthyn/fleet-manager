# Copy to .env.local and adjust. All values below are fake placeholders.
# Every variable is read on the server only: none of them reaches the browser.

# Base URL of the fleet-manager API (no trailing slash).
# Local API: http://127.0.0.1:8000   Production: https://<your-service>.onrender.com
API_URL=http://127.0.0.1:8000

# Read-only demo user used by the "Try the demo" button (created by the API's seed script).
DEMO_EMAIL=demo@fleet.dev
DEMO_PASSWORD=fake-demo-password
