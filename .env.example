# Copy to .env. As is, it runs everything against the local docker-compose database.
# Passwords and secrets below are fake placeholders: use real ones only in your .env.

# development | test | production
ENV=development

# Port used by the container entrypoint (python -m app.scripts.start). Render sets it itself.
PORT=8000

# Database URLs. The values below are the docker-compose database (127.0.0.1:5433; "localhost"
# is avoided because on Windows it tries IPv6 ::1 first and each connection then stalls ~2 s).
# DATABASE_URL is used by the application, DATABASE_URL_DIRECT by Alembic migrations.
DATABASE_URL=postgresql://fleet:fleet@127.0.0.1:5433/fleet
DATABASE_URL_DIRECT=postgresql://fleet:fleet@127.0.0.1:5433/fleet
# On Neon, paste them exactly as Neon shows them ("Connection string" format); the app adapts
# them to asyncpg. Pooled URL ("Connection pooling" ON, host contains "-pooler") for the app,
# direct URL ("Connection pooling" OFF) for migrations:
# DATABASE_URL=postgresql://fleet_user:fake-password@ep-example-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# DATABASE_URL_DIRECT=postgresql://fleet_user:fake-password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000

# Must be replaced with a long random value in production (startup fails otherwise).
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Users created by the seed script (python -m app.scripts.seed); not needed to run the API.
# demo@fleet.dev is a read-only viewer; its password is meant to be shared publicly.
DEMO_PASSWORD=fake-demo-password
# The admin can write and delete everything: keep these private.
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=fake-admin-password

# Test suite only (read by tests/conftest.py, not by the app). The suite creates this database
# on the server if it does not exist. Default: the docker-compose server.
# TEST_DATABASE_URL=postgresql://fleet:fleet@127.0.0.1:5433/fleet_test

