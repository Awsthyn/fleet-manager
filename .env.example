# Copy to .env and adjust. All values below are fake placeholders.

# development | test | production
ENV=development

# Pooled connection URL (application). On Neon, use the "-pooler" host.
DATABASE_URL=postgresql+asyncpg://fleet:fleet@localhost:5432/fleet
# Direct connection URL (Alembic migrations). On Neon, use the non-pooler host.
DATABASE_URL_DIRECT=postgresql+asyncpg://fleet:fleet@localhost:5432/fleet

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000

# Must be replaced with a long random value in production (startup fails otherwise).
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
